{
  "name": "grm-flight-deck",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "React and TypeScript first GRM flight-deck UI.",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 8081",
    "build": "tsc -b && vite build",
    "test": "npm run test:unit",
    "preview": "vite preview --host 127.0.0.1 --port 8081",
    "test:unit": "esbuild tests/graphStore.test.ts --bundle --platform=node --format=esm --outfile=/tmp/grm-flight-deck-graphStore.test.mjs && node --test /tmp/grm-flight-deck-graphStore.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:screenshots": "playwright test --project=chromium-system"
  },
  "dependencies": {
    "cytoscape": "^3.33.1",
    "lucide-react": "^1.52.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  }
}
